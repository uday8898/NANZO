{% comment %}
  KEPT, NOT RENDERED: dress-up version of the 'Get ready with nanzo' scene (fitting mirror + sprite data).
  To re-enable, render this in place of the original scene in sections/landing.liquid and use the code in
  theme-src/landing/game-dressup.js.
{% endcomment %}
  <div class="scene" id="sc">
    <div class="mirror" id="mirror" data-occ="1" aria-label="Fitting mirror">
      <div class="mr-glow"></div>
      <div class="doll" id="doll"></div>
      <span class="mr-floor"></span>
    </div>
    <div id="bub" class="p" aria-live="polite"></div>
  </div>
  <script type="application/json" id="nzl-gear">{%- assign gear_list = 'romper,camisole,tiered,denim,qbag,halter,corset,cherubtop,maxiskirt,sequin' | split: ',' -%}{ {%- for s in gear_list -%}{%- assign f = 'g-' | append: s | append: '.webp' -%}"{{ s }}":"{{ f | asset_url }}"{% unless forloop.last %},{% endunless %}{%- endfor -%} }</script>

