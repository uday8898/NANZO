<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#fcb1c4">
    <link rel="icon" type="image/png" href="{{ 'shell.png' | asset_url }}">
    <title>{{ shop.name }} – coming soon ♡</title>
    <meta name="description" content="{{ shop.name }} is almost here. Join the waitlist.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DynaPuff:wght@500;700&family=Fredoka:wght@400;500;600&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>
      window.nz = {
        launch: {{ settings.launch_date | json }},
        sound: {{ settings.sound_enabled | json }},
        scene: {{ settings.scene_3d | json }},
        currency: {{ shop.currency | json }},
        locale: {{ request.locale.iso_code | json }},
        shell: {{ 'shell.png' | asset_url | json }}
      };
      document.documentElement.classList.add('js');
    </script>
    <script src="{{ 'theme.js' | asset_url }}" type="module" defer></script>
  </head>

  <body class="template-password" data-template="password">
    {%- if settings.scene_3d -%}<canvas id="gl" aria-hidden="true"></canvas>{%- endif -%}
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor" data-cursor aria-hidden="true"></div>
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
