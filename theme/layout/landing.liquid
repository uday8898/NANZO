<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#4E331B">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" href="{{ 'shell.png' | asset_url }}">

    <title>{{ shop.name }} – After Hours</title>
    <meta name="description" content="{{ page_description | default: 'The first drop. Clothes for the part of the day that starts when everything else stops.' | escape }}">
    <meta property="og:title" content="{{ shop.name }} – After Hours">
    <meta property="og:type" content="website">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Cormorant+Garamond:wght@500;600&family=Pinyon+Script&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {{ 'landing.css' | asset_url | stylesheet_tag }}
    {{ 'crazy.css' | asset_url | stylesheet_tag }}
    <script>
      window.nz = {
        currency: {{ shop.currency | json }},
        locale: {{ request.locale.iso_code | json }}
      };
    </script>
    <script src="{{ 'landing.js' | asset_url }}" type="module" defer></script>
  </head>

  <body class="theme-landing" data-template="{{ template.name }}">
    <noscript><style>#gate{display:none!important}body:not(.go){overflow:auto!important;height:auto!important}.moon,.hero h1.lg{opacity:1!important;transform:none!important}</style></noscript>
    {{ content_for_layout }}
  </body>
</html>
