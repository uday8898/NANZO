{%- comment -%}
  Our world: ONLY the visual world page. A huge fixed title over two staggered columns of tall pictures that drift
  at different speeds (layout idea from the reference). No story, pillars, currency or founder copy here: those are
  their own sections on the home page.
{%- endcomment -%}
<style>.ow{--s:url('{{ 'shell.png' | asset_url }}')}</style>
<section class="ow" data-ow>
  <h1 class="ow__title" aria-label="Our world"><span>OUR</span> <span>WORLD</span></h1>

  <div class="ow__grid">
    <div class="ow__col">
      <figure class="ow__t ow__t--tall" style="--img:url('{{ 'landing-i0.webp' | asset_url }}')"><figcaption>Raw shoot</figcaption></figure>
      <figure class="ow__t ow__t--sq" style="--img:url('{{ 'landing-i3.webp' | asset_url }}')"><figcaption>Behind the scenes</figcaption></figure>
      <figure class="ow__t ow__t--arch" style="--g:linear-gradient(#FCB1C5,#FFFAF0)"><i></i><figcaption>The box</figcaption></figure>
      <figure class="ow__t ow__t--tall" style="--img:url('{{ 'landing-i5.webp' | asset_url }}')"><figcaption>After Hours</figcaption></figure>
    </div>

    <div class="ow__col ow__col--b">
      <figure class="ow__t ow__t--sq" style="--img:url('{{ 'landing-i1.webp' | asset_url }}')"><figcaption>Campaign</figcaption></figure>
      <figure class="ow__t ow__t--tall" style="--img:url('{{ 'landing-i4.webp' | asset_url }}')"><figcaption>Raw shoot</figcaption></figure>
      <figure class="ow__t ow__t--sq" style="--img:url('{{ 'landing-i2.webp' | asset_url }}')"><figcaption>Fitting day</figcaption></figure>
      <figure class="ow__t ow__t--arch" style="--g:linear-gradient(#D9E8E1,#FFE9EF)"><i></i><figcaption>The collectible</figcaption></figure>
    </div>
  </div>

  <div class="ow__end">
    <a class="btn-brown" href="{{ routes.all_products_collection_url }}">Shop After Hours</a>
  </div>
</section>

{% schema %}
{ "name": "Our world", "settings": [], "presets": [{ "name": "Our world" }] }
{% endschema %}
