{%- paginate collection.products by 12 -%}
<section class="sheet page-top">
  <div class="wrap">
    <header class="sec-head sec-head--left" data-reveal>
      <span class="eyebrow">collection</span>
      <h1 class="h-xl">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<p class="lede">{{ collection.description | strip_html | truncate: 200 }}</p>{%- endif -%}
    </header>

    <div class="grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="muted">Nothing here yet — check back soon ♡</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Collection page", "settings": [] }
{% endschema %}
