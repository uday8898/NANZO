{%- paginate collection.products by section.settings.per_page -%}
<section class="coll">
  <div class="coll__wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>{% if collection.handle == 'all' %}Shop all{% else %}{{ collection.title }}{% endif %}</span></nav>

    <header class="coll__head">
      <h1 class="coll__title">{% if collection.handle == 'all' %}Shop all{% else %}{{ collection.title }}{% endif %}</h1>
      {%- if collection.description != blank -%}
        <p class="coll__tag">{{ collection.description | strip_html | truncate: 120 }}</p>
      {%- endif -%}
    </header>

    {%- if collection.all_types.size > 1 -%}
      <nav class="coll__types" aria-label="Filter by type">
        <a class="chip{% if collection.current_type == blank %} is-on{% endif %}" href="{{ routes.all_products_collection_url }}">All</a>
        {%- for type in collection.all_types -%}
          <a class="chip{% if collection.current_type == type %} is-on{% endif %}" href="{{ type | url_for_type }}">{{ type }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="coll__bar">
      <span class="coll__count">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span>
      {%- if collection.sort_options.size > 0 -%}
        <form class="coll__sort" method="get">
          <label for="sort">Sort by</label>
          <select id="sort" name="sort_by" onchange="this.form.submit()">
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            {%- for opt in collection.sort_options -%}
              <option value="{{ opt.value }}" {% if opt.value == current_sort %}selected{% endif %}>{{ opt.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>

    <div class="coll__grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="coll__empty"><i class="lg" style="--src:url('{{ 'shell.png' | asset_url }}')"></i><p>Nothing here yet. Check back soon.</p></div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="Pagination">
        {%- if paginate.previous -%}<a class="pager__a" href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
        <span class="pager__now">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="pager__a" href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Pieces per page", "min": 8, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
