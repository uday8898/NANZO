<section class="pw">
  <div class="pw__bg" aria-hidden="true"><div class="hero__aurora"><i></i><i></i><i></i></div></div>

  <button class="sound-btn sound-btn--float" type="button" data-sound-toggle aria-pressed="true" aria-label="Sound on or off">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 5 6 9H3v6h3l5 4z"/><path class="wave" d="M15.5 8.5a5 5 0 0 1 0 7"/><path class="wave" d="M18.5 5.5a9 9 0 0 1 0 13"/><path class="mute" d="m16 9 5 6m0-6-5 6"/>
    </svg>
    <span data-sound-label>sound on</span>
  </button>

  <div class="pw__inner">
    <div class="hero__word pw__word">
      {%- for l in (1..4) -%}
        <i class="lg hero__layer hero__layer--{{ l }}" style="--src:url('{{ 'logo-horizontal.png' | asset_url }}')"></i>
      {%- endfor -%}
      <h1 class="sr">{{ shop.name }}</h1>
    </div>

    <span class="badge">{{ section.settings.badge }}</span>
    <p class="hero__sub">{{ section.settings.subtitle }}</p>

    <div class="cd" data-countdown="{{ settings.launch_date }}">
      <div><b data-cd="d">00</b><small>days</small></div>
      <div><b data-cd="h">00</b><small>hrs</small></div>
      <div><b data-cd="m">00</b><small>min</small></div>
      <div><b data-cd="s">00</b><small>sec</small></div>
    </div>

    {%- comment -%} Creates a Shopify customer (email marketing: subscribed) tagged "waitlist" → Admin › Customers {%- endcomment -%}
    {% render 'waitlist-form', cta: section.settings.button_label %}
  </div>
</section>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "coming soon ♡" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "cute fits, big feelings. something dreamy is washing ashore." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "notify me ✧" }
  ]
}
{% endschema %}
