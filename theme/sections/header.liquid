<header class="shdr" data-header>
  <div class="shdr__inner">
    <a class="shdr__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      <i class="lg" style="--src:url('{{ 'logo-horizontal.png' | asset_url }}');--c:var(--pink)"></i>
    </a>

    <nav class="shdr__nav" aria-label="Main">
      {%- comment -%} fixed nanzo links (the Shopify default menu was Home / Catalog / Contact). To use a menu again, switch this back to: for link in linklists[section.settings.menu].links {%- endcomment -%}
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.all_products_collection_url }}">Shop all</a>
      <a href="{{ routes.collections_url }}after-hours">After Hours</a>
      <a href="{{ routes.root_url }}pages/our-world">Our world</a>
    </nav>

    <div class="shdr__actions">
      <button class="sound-btn sound-btn--mini" type="button" data-sound-toggle aria-pressed="true" aria-label="Sound on or off">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5 6 9H3v6h3l5 4z"/><path class="wave" d="M15.5 8.5a5 5 0 0 1 0 7"/><path class="wave" d="M18.5 5.5a9 9 0 0 1 0 13"/><path class="mute" d="m16 9 5 6m0-6-5 6"/>
        </svg>
        <span data-sound-label>sound on</span>
      </button>

      <button class="bagbtn" type="button" data-cart-open aria-label="Open cart">
        <svg viewBox="0 0 64 58" width="54" height="49" aria-hidden="true">
          <path d="M19 25C19 6 45 6 45 25" fill="none" stroke="#ee86ab" stroke-width="5" stroke-linecap="round"/>
          <path d="M5 25h54l-6 28a4 4 0 0 1-4 3H15a4 4 0 0 1-4-3z" fill="#f9a9c5" stroke="#ee86ab" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M20 31v19M32 31v19M44 31v19M10 38h44M12 46h40" stroke="#fff" stroke-opacity=".55" stroke-width="2.4" stroke-linecap="round"/>
          <ellipse cx="24" cy="30" rx="9" ry="3" fill="#fff" fill-opacity=".35"/>
        </svg>
        <b data-cart-count>{{ cart.item_count }}</b>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
