<section class="pw">
  <div class="pw__bg" aria-hidden="true"><div class="hero__aurora"><i></i><i></i><i></i></div></div>

  <div class="pw__inner">
    <div class="hero__word pw__word">
      {%- for l in (1..4) -%}
        <i class="lg hero__layer hero__layer--{{ l }}" style="--src:url('{{ 'logo-horizontal.png' | asset_url }}')"></i>
      {%- endfor -%}
      <h1 class="sr">{{ shop.name }}</h1>
    </div>

    <span class="badge">coming soon ♡</span>
    <p class="hero__sub">{{ shop.password_message | default: 'something dreamy is washing ashore.' }}</p>

    <div class="cd" data-countdown="{{ settings.launch_date }}">
      <div><b data-cd="d">00</b><small>days</small></div>
      <div><b data-cd="h">00</b><small>hrs</small></div>
      <div><b data-cd="m">00</b><small>min</small></div>
      <div><b data-cd="s">00</b><small>sec</small></div>
    </div>

    {% render 'waitlist-form', cta: 'notify me ✧' %}

    <details class="pw__enter">
      <summary>store owner? enter with password</summary>
      {%- form 'storefront_password' -%}
        <label class="sr" for="pw-input">Password</label>
        <input id="pw-input" type="password" name="password" placeholder="password" autocomplete="current-password" required>
        <button class="btn btn--glass" type="submit">enter</button>
        {%- if form.errors -%}<p class="waitlist__msg waitlist__msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
