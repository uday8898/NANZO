<div class="bar" role="region" aria-label="Announcement">
  <p>{{ section.settings.text_1 }}{% if section.settings.text_2 != blank %} <span class="bar__sep" aria-hidden="true">|</span> {{ section.settings.text_2 }}{% endif %}</p>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text_1", "label": "Text 1", "default": "Free shipping over ₹3000" },
    { "type": "text", "id": "text_2", "label": "Text 2", "default": "Tried, tested and loved by 100,000+ girlies all over India", "info": "Only keep a claim like this if it is true for nanzo." }
  ]
}
{% endschema %}
