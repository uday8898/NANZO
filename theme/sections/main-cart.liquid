<section class="sheet page-top">
  <div class="wrap cartpage">
    <header class="sec-head sec-head--left"><span class="eyebrow">your bag</span><h1 class="h-xl">bag</h1></header>

    {%- if cart.item_count == 0 -%}
      <div class="empty"><i class="lg" style="--src:url('{{ 'shell.png' | asset_url }}')"></i><p>your bag is feeling empty ♡</p><a class="btn" href="{{ routes.all_products_collection_url }}">go shopping</a></div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post">
        <ul class="lines">
          {%- for item in cart.items -%}
            <li class="line">
              <a class="line__img" href="{{ item.url }}">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" loading="lazy" width="120" height="150">{%- else -%}<span class="lg" style="--src:url('{{ 'shell.png' | asset_url }}')"></span>{%- endif -%}
              </a>
              <div class="line__info">
                <a href="{{ item.url }}"><b>{{ item.product.title }}</b></a>
                {%- unless item.product.has_only_default_variant -%}<span class="muted">{{ item.variant.title }}</span>{%- endunless -%}
                <span>{{ item.final_price | money }}</span>
              </div>
              <input class="line__qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}">
              <b class="line__total">{{ item.final_line_price | money }}</b>
              <a class="line__rm" href="{{ item.url_to_remove }}" aria-label="Remove">✕</a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="cartpage__foot">
          <p class="muted">Taxes & shipping calculated at checkout.</p>
          <p class="cartpage__total"><span>subtotal</span> <b>{{ cart.total_price | money }}</b></p>
          <div class="cartpage__btns">
            <button class="btn btn--glass" type="submit" name="update">update bag</button>
            <button class="btn" type="submit" name="checkout">checkout ✧</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart page", "settings": [] }
{% endschema %}
